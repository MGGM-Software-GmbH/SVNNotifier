<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>false</WindowsAppSdkUndockedRegFreeWinRTInitialize>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>CHD.SVN_Notifier.Program</StartupObject>
    <Platforms>x64;x86</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CHD.SVN_Notifier</RootNamespace>
    <AssemblyName>SVN_Notifier</AssemblyName>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <AssemblyTitle>SVN Notifier</AssemblyTitle>
    <AssemblyVersion>3.1.0.1</AssemblyVersion>
    <FileVersion>3.1.0.1</FileVersion>
    <Version>3.1.0.1</Version>
    <InformationalVersion>3.1.0.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>CHD</Company>
    <Product>SVN Notifier</Product>
    <Copyright>Copyright (C) 2007-2011 CHD  |  v3 (C) 2026 MGGM-Software</Copyright>
    <Description>Notifies you about other people's commits to Subversion repositories</Description>
    <ProjectGuid>{047E30FF-665B-422C-9877-8983961F848A}</ProjectGuid>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugType>embedded</DebugType>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SVN_Notifier.Core/SVN_Notifier.Core.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <Compile Remove="*Form*.cs;Common/ApplicationTheme.cs;Common/ControlHelper.cs;Common/DialogLayout.cs;Common/UiIcons.cs;Properties/Resources.Designer.cs" />
    <EmbeddedResource Remove="*.resx;Properties/Resources.resx" />
    <EmbeddedResource Include="Images/Icons/TrayIcon_*.ico" />
    <Compile Remove="Common/Attributes.cs;Common/Config.cs;Common/IniFile.cs;Common/Loc.cs;Common/PathType.cs;Common/SvnItem.cs;Common/SvnOperationRunner.cs;Common/SvnStatus.cs;Common/SvnTools.cs;Common/SvnXml.cs;Common/WindowsPathComparer.cs;Common/WorkingCopyLease.cs" />
    <InternalsVisibleTo Include="Svn.Tests" />
    <InternalsVisibleTo Include="Gui.Tests" />
    <!-- Designer-generated files: disable nullable analysis to avoid noise -->
    <Compile Update="AboutForm.Designer.cs">
      <DependentUpon>AboutForm.cs</DependentUpon>
    </Compile>
    <Compile Update="ErrorLogForm.Designer.cs">
      <DependentUpon>ErrorLogForm.cs</DependentUpon>
    </Compile>
    <Compile Update="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <Compile Update="MainForm.Tools.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <Compile Update="SettingsForm.Designer.cs">
      <DependentUpon>SettingsForm.cs</DependentUpon>
    </Compile>
    <Compile Update="PropertiesForm.Designer.cs">
      <DependentUpon>PropertiesForm.cs</DependentUpon>
    </Compile>
    <Compile Update="UpdateLogForm.Designer.cs">
      <DependentUpon>UpdateLogForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="AboutForm.resx">
      <DependentUpon>AboutForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="ErrorLogForm.resx">
      <DependentUpon>ErrorLogForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="SettingsForm.resx">
      <DependentUpon>SettingsForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="PropertiesForm.resx">
      <DependentUpon>PropertiesForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="UpdateLogForm.resx">
      <DependentUpon>UpdateLogForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
