<UserControl x:Class="CHD.SVN_Notifier.RepositoryPropertiesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
        <StackPanel Spacing="12" MinWidth="320">
            <TextBox x:Name="PathInput" AutomationProperties.AutomationId="RepositoryPath" />
            <CheckBox x:Name="EnabledInput" Click="UpdateEnabled" />
            <CheckBox x:Name="AutoUpdateInput" />
            <CheckBox x:Name="CustomInput" Click="UpdateEnabled" />
            <StackPanel x:Name="Intervals" Spacing="12">
                <NumberBox x:Name="ActiveInput" Minimum="0" Maximum="359999" SpinButtonPlacementMode="Compact" />
                <NumberBox x:Name="IdleInput" Minimum="0" Maximum="359999" SpinButtonPlacementMode="Compact" />
            </StackPanel>
            <TextBlock x:Name="ValidationError" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
