<UserControl x:Class="CHD.SVN_Notifier.RepositoryStatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnSpacing="8" VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Unknown">
                    <VisualState.Setters>
                        <Setter Target="Icon.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Target="StatusLabel.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Incoming">
                    <VisualState.Setters>
                        <Setter Target="Icon.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <Setter Target="StatusLabel.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Synchronized">
                    <VisualState.Setters>
                        <Setter Target="Icon.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="StatusLabel.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Modified">
                    <VisualState.Setters>
                        <Setter Target="Icon.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="StatusLabel.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Error">
                    <VisualState.Setters>
                        <Setter Target="Icon.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="StatusLabel.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <FontIcon x:Name="Icon" FontSize="16" />
        <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock x:Name="StatusLabel" Text="{x:Bind Text, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
