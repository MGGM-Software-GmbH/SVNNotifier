<Window x:Class="CHD.SVN_Notifier.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CHD.SVN_Notifier">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="12" RowSpacing="8">
        <Grid.Resources>
            <local:StatusTextConverter x:Key="StatusText" />
            <local:StatusIconConverter x:Key="StatusIcon" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <MenuBar x:Name="Menus" />
        <CommandBar x:Name="Commands" Grid.Row="1" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" />
        <Grid Grid.Row="2" RowSpacing="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid x:Name="Headers" Padding="12,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" /><ColumnDefinition Width="28" /><ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MonitorHeader" TextWrapping="Wrap" /><TextBlock x:Name="StatusHeader" Grid.Column="2" />
                <TextBlock x:Name="PathHeader" Grid.Column="3" /><TextBlock x:Name="AutoHeader" Grid.Column="4" TextWrapping="Wrap" />
            </Grid>
            <ListView x:Name="Repositories" Grid.Row="1" SelectionMode="Single" IsItemClickEnabled="False"
                AllowDrop="True" DragOver="Repositories_DragOver" Drop="Repositories_Drop"
                SelectionChanged="Repositories_SelectionChanged" DoubleTapped="Repositories_DoubleTapped"
                KeyDown="Repositories_KeyDown" RightTapped="Repositories_RightTapped"
                AutomationProperties.AutomationId="Repositories">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8" Padding="0,4" MinHeight="32" Loaded="RepositoryRow_Loaded">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" /><ColumnDefinition Width="28" /><ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Click="RepositoryToggle_Click" AutomationProperties.AutomationId="MonitorToggle" />
                            <FontIcon Grid.Column="1" Glyph="{Binding DisplayIconStatus, Converter={StaticResource StatusIcon}}" FontSize="18" />
                            <TextBlock Grid.Column="2" Text="{Binding DisplayStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="3" Text="{Binding VisiblePath}" ToolTipService.ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="4" IsChecked="{Binding AutoUpdate, Mode=TwoWay}" Click="RepositoryToggle_Click" AutomationProperties.AutomationId="AutoUpdateToggle" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyState" Grid.Row="1" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.AutomationId="StatusText" />
            <Button x:Name="ErrorsButton" Grid.Column="1" Click="ErrorsButton_Click" />
        </Grid>
    </Grid>
</Window>
