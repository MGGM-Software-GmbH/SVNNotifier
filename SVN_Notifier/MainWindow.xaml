<Window x:Class="CHD.SVN_Notifier.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CHD.SVN_Notifier">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20,4,20,12" RowSpacing="12">
        <Grid.Resources>
            <local:StatusTextConverter x:Key="StatusText" />
            <local:StatusIconConverter x:Key="StatusIcon" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <MenuBar x:Name="Menus" />
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <TextBlock x:Name="RepositoryTitle" Tag="Typography.Title" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <CommandBar x:Name="Commands" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" HorizontalContentAlignment="Left" Background="Transparent" Padding="8" />
            <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid x:Name="Headers" Padding="16,12" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" /><ColumnDefinition Width="28" /><ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MonitorHeader" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="StatusHeader" Grid.Column="1" Grid.ColumnSpan="2" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="PathHeader" Grid.Column="3" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="AutoHeader" Grid.Column="4" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            </Border>
            <ListView x:Name="Repositories" Grid.Row="2" SelectionMode="Single" IsItemClickEnabled="False" Margin="4,4,4,8"
                AllowDrop="True" DragOver="Repositories_DragOver" Drop="Repositories_Drop"
                SelectionChanged="Repositories_SelectionChanged" DoubleTapped="Repositories_DoubleTapped"
                KeyDown="Repositories_KeyDown" RightTapped="Repositories_RightTapped"
                AutomationProperties.AutomationId="Repositories">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8" Padding="0,9" MinHeight="48" Loaded="RepositoryRow_Loaded">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" /><ColumnDefinition Width="28" /><ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" Click="RepositoryToggle_Click" AutomationProperties.AutomationId="MonitorToggle" />
                            <local:RepositoryStatusView Grid.Column="1" Grid.ColumnSpan="2" Status="{Binding DisplayIconStatus}" Text="{Binding DisplayStatus}" />
                            <TextBlock Grid.Column="3" Text="{Binding VisiblePath}" ToolTipService.ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Medium" />
                            <CheckBox Grid.Column="4" IsChecked="{Binding AutoUpdate, Mode=TwoWay}" Click="RepositoryToggle_Click" AutomationProperties.AutomationId="AutoUpdateToggle" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyState" Grid.Row="2" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="24" />
        </Grid>
        </Border>
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.AutomationId="StatusText" />
            <Button x:Name="ErrorsButton" Grid.Column="1" Click="ErrorsButton_Click" />
        </Grid>
    </Grid>
</Window>
